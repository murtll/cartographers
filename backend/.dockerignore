# Контекст сборки — эта папка (см. `build: ./backend` в docker-compose.yml).
# Всё, что сюда попадает, участвует в хеше слоя `COPY . .` из Dockerfile:
# один локальный `go build` — и слой пересобирается с нуля.

# Бинарники от локального `go build` (8 МБ каждый). В образе они не нужны:
# Dockerfile собирает свой на этапе build. Те же имена — в .gitignore.
server
app

# Артефакты тестов и профилирования — `go test -c`, `-coverprofile`, pprof.
# Дубли с `**/` нужны, чтобы поймать их и во вложенных пакетах.
*.test
*.out
**/*.test
**/*.out
